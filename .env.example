# Copie para .env.local e preencha. Nunca commite valores reais.

# Neon Postgres (string com sslmode=require)
DATABASE_URL=

# Better Auth (self-hosted). Gere o segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM para credenciais de provedor e conexoes OpenCode.
# Chave de 32 bytes em base64, versionada por key_version.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# E-mail transacional (verificacao de conta, convites)
RESEND_API_KEY=
EMAIL_FROM=cvopencode <no-reply@example.com>

# Gateway OpenCode opcional (padrao: servidor publico, sem token)
OPENCODE_GATEWAY_URL=
OPENCODE_GATEWAY_TOKEN=

# Base publica usada em links absolutos
NEXT_PUBLIC_APP_URL=http://localhost:3000
